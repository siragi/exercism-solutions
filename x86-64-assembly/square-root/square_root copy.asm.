section .text

global square_root
square_root:
    ; rdi: int
    cvtsi2sd xmm0, rdi ; Convert scalar integer to 64-bit float (scalar double precision) and store in XMM0 (scalar: no list, just an entry)
    sqrtsd xmm0, xmm0 ; SSE (Streaming SIMD Extensions) instruction (not FPU/x87)
    cvtsd2si rax, xmm0
    
    ret

%ifidn __OUTPUT_FORMAT__,elf64
section .note.GNU-stack noalloc noexec nowrite progbits
%endif
